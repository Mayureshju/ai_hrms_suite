{
  "doctype": "DocType",
  "name": "AI Run Log",
  "module": "AI HRMS Suite",
  "custom": 0,
  "track_changes": 1,
  "autoname": "format:AI-LOG-{#####}",
  "fields": [
    { "fieldname": "run_type", "fieldtype": "Select", "label": "Run Type", "options": "parse_resume\nscore_resume", "reqd": 1, "in_list_view": 1 },
    { "fieldname": "provider", "fieldtype": "Data", "label": "Provider", "read_only": 1, "in_list_view": 1 },
    { "fieldname": "model", "fieldtype": "Data", "label": "Model", "read_only": 1 },
    { "fieldname": "tokens_in", "fieldtype": "Int", "label": "Tokens In", "read_only": 1 },
    { "fieldname": "tokens_out", "fieldtype": "Int", "label": "Tokens Out", "read_only": 1 },
    { "fieldname": "cost_usd", "fieldtype": "Currency", "label": "Cost USD", "read_only": 1 },
    { "fieldname": "latency_ms", "fieldtype": "Int", "label": "Latency (ms)", "read_only": 1 },
    { "fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Success\nFailed", "reqd": 1, "in_list_view": 1 },
    { "fieldname": "error", "fieldtype": "Long Text", "label": "Error", "read_only": 1 }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 0, "create": 0, "delete": 0, "report": 1, "export": 1, "print": 1, "share": 0 },
    { "role": "HR Manager", "read": 1, "write": 0, "create": 0, "delete": 0, "report": 1, "export": 0, "print": 0, "share": 0 }
  ]
}
