{
  "doctype": "DocType",
  "name": "AI Chat Message",
  "module": "AI HRMS Suite",
  "custom": 0,
  "track_changes": 1,
  "autoname": "format:AI-CHAT-MSG-{#####}",
  "fields": [
    { "fieldname": "session", "fieldtype": "Link", "label": "Session", "options": "AI Chat Session", "reqd": 1, "in_list_view": 1 },
    { "fieldname": "role", "fieldtype": "Select", "label": "Role", "options": "user\nassistant\nsystem\ntool", "reqd": 1, "in_list_view": 1 },
    { "fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Success\nFailed", "default": "Success", "in_list_view": 1 },
    { "fieldname": "content", "fieldtype": "Long Text", "label": "Content" },
    { "fieldname": "plan_json", "fieldtype": "Long Text", "label": "Plan JSON", "read_only": 1 },
    { "fieldname": "context_json", "fieldtype": "Long Text", "label": "Context JSON", "read_only": 1 },
    { "fieldname": "sources_json", "fieldtype": "Long Text", "label": "Sources JSON", "read_only": 1 },
    { "fieldname": "provider", "fieldtype": "Data", "label": "Provider", "read_only": 1 },
    { "fieldname": "model", "fieldtype": "Data", "label": "Model", "read_only": 1 },
    { "fieldname": "tokens_in", "fieldtype": "Int", "label": "Tokens In", "read_only": 1 },
    { "fieldname": "tokens_out", "fieldtype": "Int", "label": "Tokens Out", "read_only": 1 },
    { "fieldname": "cost_usd", "fieldtype": "Currency", "label": "Cost USD", "read_only": 1 },
    { "fieldname": "latency_ms", "fieldtype": "Int", "label": "Latency (ms)", "read_only": 1 },
    { "fieldname": "error", "fieldtype": "Small Text", "label": "Error", "read_only": 1 }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "print": 1, "share": 1 },
    { "role": "All", "read": 1, "write": 1, "create": 1, "delete": 0, "report": 0, "export": 0, "print": 0, "share": 0, "if_owner": 1 }
  ]
}

