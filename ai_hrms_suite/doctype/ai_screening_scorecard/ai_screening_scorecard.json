    { "fieldname": "job_opening", "fieldtype": "Link", "label": "Job Opening", "options": "Job Opening", "reqd": 1, "in_list_view": 1 },
    { "fieldname": "applicant", "fieldtype": "Link", "label": "Job Applicant", "options": "Job Applicant", "reqd": 1, "in_list_view": 1 },
    { "fieldname": "match_score", "fieldtype": "Float", "label": "Match Score", "read_only": 1, "in_list_view": 1 },
    { "fieldname": "strengths", "fieldtype": "Long Text", "label": "Strengths", "read_only": 1 },
    { "fieldname": "gaps", "fieldtype": "Long Text", "label": "Gaps", "read_only": 1 },
    { "fieldname": "risk_flags", "fieldtype": "Long Text", "label": "Risk Flags", "read_only": 1 },
    { "fieldname": "explanation", "fieldtype": "Long Text", "label": "Explanation", "read_only": 1 },
    { "fieldname": "score_version", "fieldtype": "Data", "label": "Score Version", "default": "v1", "read_only": 1 }
